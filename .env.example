# PostgreSQL Database Configuration
POSTGRES_USER=tailwind
POSTGRES_PASSWORD=tailwind_dev_password
POSTGRES_DB=tailwind
POSTGRES_PORT=5432

# Database Connection String
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://tailwind:tailwind_dev_password@localhost:5432/tailwind

# ASP.NET Core Environment
ASPNETCORE_ENVIRONMENT=Development

# Mail Server Port
SERVER_PORT=5000

# SMTP Configuration
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=

# Default Email Settings
DEFAULT_FROM=test@tailwind.dev

# Ethereal Email (for testing - get credentials from https://ethereal.email)
ETHEREAL_USER=
ETHEREAL_PASSWORD=

# Background Worker Configuration
SEND_WORKER=local
